# Copy to `.env` (same directory) and fill in your key. `.env` is gitignored.
#
# Free key: https://openweathermap.org/api  →  "Current Weather Data".
# A newly created key takes ~10 minutes to activate; until then the API
# returns HTTP 401 and the dashboard will report every station as failed
# rather than substituting an estimated temperature.

OPENWEATHER_API_KEY=your_key_here
