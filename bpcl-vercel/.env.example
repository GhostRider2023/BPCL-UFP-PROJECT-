# Optional. The app works with no key at all — it falls back to Open-Meteo,
# which needs none, and labels every reading with the source that produced it.
#
# Free key: https://openweathermap.org/api  ->  "Current Weather Data".
# A newly created key takes ~10 minutes to activate; until then the API returns
# HTTP 401 and the app falls through to Open-Meteo rather than substituting an
# estimated temperature.
#
# On Vercel, set this in Project Settings -> Environment Variables instead of
# committing a file.
OPENWEATHER_API_KEY=

# auto (default) | openweather | open-meteo
#   auto        OpenWeather when a key is configured, else Open-Meteo
#   openweather fail rather than fall back — useful for testing the key
#   open-meteo  skip OpenWeather entirely
AIR_TEMPERATURE_PROVIDER=auto
