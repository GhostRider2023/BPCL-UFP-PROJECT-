node_modules/
dist/
.vercel/
*.local
*.tsbuildinfo

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Secrets. The OpenWeather key is never committed — on Vercel it belongs in
# Project Settings -> Environment Variables. The app works without one.
# `.env.local` is written by `vercel link` and holds a VERCEL_OIDC_TOKEN.
.env
.env.*
openweather_key.txt

# Large regeneration inputs, not runtime data.
*.nc
*.grib

.DS_Store

# The negation has to come last: `vercel link` appends its own `.env*` rule to
# the end of this file, and a later pattern beats an earlier negation.
!.env.example
