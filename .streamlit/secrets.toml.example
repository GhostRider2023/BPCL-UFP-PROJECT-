# Copy to `.streamlit/secrets.toml` and fill in your key.
# `secrets.toml` is gitignored; this example file is not.
#
# This is the right place for the key when deploying to Streamlit Community
# Cloud: paste the same line into the app's "Secrets" box in the dashboard
# settings, and no file needs to exist in the repository at all.
#
# Free key: https://openweathermap.org/api  ->  "Current Weather Data".

OPENWEATHER_API_KEY = "your_key_here"
